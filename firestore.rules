rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
      All data access is intentionally denied from the browser.

      Firebase Authentication signs the person in, but the browser must call
      Express with its Firebase ID token. The Express server uses Firebase
      Admin SDK, applies role/flight checks and then accesses Firestore.

      Firebase Admin SDK bypasses these rules securely on the server.
      This stops direct browser writes to wallet balances, attendance, prices,
      stock, roles, business approval, or any other protected club data.
    */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
