rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Browser code does not directly modify attendance, finance, members, stock, sessions, or ads.
    // Express + Firebase Admin is the sole write authority for protected club data.
    match /publicBusinesses/{id} { allow read: if true; allow write: if false; }
    match /publicNotices/{id} { allow read: if resource.data.status == "APPROVED"; allow write: if false; }
    match /members/{uid} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
